# Real backend base URL
# In Docker (recommended): keep this as /api and use Vite proxy (configured in vite.config.js).
# For non-docker local dev, you can set: http://127.0.0.1:8000/api
VITE_API_BASE_URL=/api

# Legacy mock flags are ignored in current frontend build (runtime is real-only).
VITE_USE_MOCK_API=false
VITE_USE_MOCK_FALLBACK=false

# Optional artificial latency for legacy mocks (currently unused)
VITE_MOCK_DELAY_MS=0

# Optional auth header prefix. Leave empty for auto-detect:
# - JWT-like token => Bearer
# - DRF token => Token
# VITE_AUTH_TOKEN_PREFIX=Token

# Backend credentials are managed by backend seed/admin commands.
