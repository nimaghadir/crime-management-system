# Real backend base URL
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# true: use frontend local mock storage for supported endpoints
# false: call real backend APIs
VITE_USE_MOCK_API=true

# If real API call fails, fallback to mock (only for endpoints with mock handlers)
VITE_USE_MOCK_FALLBACK=true

# Optional artificial latency (ms) for mock responses
VITE_MOCK_DELAY_MS=120

# Mock credentials (when VITE_USE_MOCK_API=true)
# sysadmin / admin123
# detective / detective123
# sergeant / sergeant123
# captain / captain123
# citizen / citizen123
